{
  "name": "boundry-maintenance",
  "version": "0.1.0",
  "private": true,
  "description": "Package, release, and project maintenance inventory for the Boundry ecosystem (npm + crates.io), published as a static GitHub Pages dashboard.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "scan": "node src/index.ts scan",
    "report": "node src/index.ts report",
    "validate": "node src/index.ts validate",
    "schemas": "node src/index.ts schemas",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "check": "npm run typecheck && npm test && npm run validate"
  },
  "dependencies": {
    "semver": "^7.8.6",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/semver": "^7.8.0",
    "typescript": "^5.9.3"
  }
}
