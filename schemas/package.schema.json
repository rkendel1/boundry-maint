{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Name as published in the registry"
          },
          "registry": {
            "type": "string",
            "enum": [
              "npm",
              "crates"
            ]
          },
          "ownership": {
            "type": "string",
            "enum": [
              "owned",
              "managed",
              "upstream"
            ]
          },
          "repository": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
              },
              {
                "type": "null"
              }
            ],
            "description": "GitHub repository holding the source, if known"
          },
          "directory": {
            "description": "Path of the package inside the repository",
            "type": "string"
          },
          "active": {
            "default": true,
            "type": "boolean"
          },
          "trackPrereleases": {
            "default": false,
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "criticality": {
            "default": "medium",
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "release": {
            "description": "Present only for owned packages Boundry is allowed to release",
            "type": "object",
            "properties": {
              "allowedBumps": {
                "default": [
                  "patch",
                  "minor",
                  "prerelease",
                  "repository"
                ],
                "description": "Bumps a release request may ask for. 'repository' = release the version already declared in the manifest, if unpublished. 'major' must be listed explicitly.",
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "patch",
                    "minor",
                    "major",
                    "prepatch",
                    "preminor",
                    "premajor",
                    "prerelease",
                    "repository"
                  ]
                }
              },
              "prereleaseId": {
                "default": "rc",
                "type": "string",
                "pattern": "^[0-9A-Za-z-]+$"
              },
              "tagFormat": {
                "default": "{name}@{version}",
                "description": "Git tag per released package; {name} and {version} are substituted",
                "type": "string"
              },
              "branch": {
                "default": "main",
                "description": "Branch that receives the release commit (fast-forward only)",
                "type": "string"
              },
              "approvers": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "People who may approve a release plan for this package (in addition to holding the approver role)"
              },
              "approvalsRequired": {
                "default": 1,
                "description": "Distinct people who must approve; a critical package always needs at least 2",
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "protected": {
                "default": true,
                "description": "Approving needs the prod_approver role. Publishing to a public registry is production, so the default is protected",
                "type": "boolean"
              },
              "frozen": {
                "default": false,
                "description": "While frozen, releases of this package are neither approved nor executed; approved releases wait",
                "type": "boolean"
              },
              "freezeReason": {
                "type": "string"
              },
              "validation": {
                "default": [
                  "test"
                ],
                "description": "Checks the release build must pass in Boundry CI before tagging",
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "test"
                  ]
                }
              },
              "githubRelease": {
                "default": true,
                "type": "boolean"
              },
              "distTag": {
                "default": "latest",
                "description": "npm dist-tag for stable releases (prereleases always use 'next')",
                "type": "string"
              }
            },
            "required": [
              "approvers"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "registry",
          "ownership",
          "repository"
        ]
      }
    }
  },
  "required": [
    "packages"
  ]
}
